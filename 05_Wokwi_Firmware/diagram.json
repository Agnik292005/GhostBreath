    ["esp:GND.1",  "pot_co2:GND", "black", ["h-50", "v-80",  "h-140"]],
    ["pot_co2:SIG","esp:D34",     "green", ["h40",  "v130",  "h160"]],

    ["esp:3V3.2",  "pot_teg:VCC", "red",   ["h100", "v-100", "h160"]],
